{
  "name": "deskatlas",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": ".venv/bin/python scripts/dev.py",
    "dev:web": "next dev",
    "dev:api": ".venv/bin/python -m uvicorn backend.app.main:app --reload --host 127.0.0.1 --port 8000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:api": ".venv/bin/python -m pytest backend/tests -q",
    "test:layout": "node --experimental-strip-types --test scripts/test_seat_layout.mjs",
    "test:web": "node scripts/check_web_conventions.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test:web && pnpm test:api && pnpm test:layout && pnpm test:header",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": ".venv/bin/python -m alembic -c backend/alembic.ini upgrade head",
    "admin:hash": ".venv/bin/python scripts/hash_admin_password.py",
    "admin:set": ".venv/bin/python scripts/hash_admin_password.py --save",
    "build:static": "DESKATLAS_STATIC=1 next build",
    "serve:static": "DESKATLAS_DATA_DIR=outputs/sqlite-data .venv/bin/python -m uvicorn backend.app.main:app --host 0.0.0.0 --port 8080",
    "desktop:dev": "DESKATLAS_DATA_DIR=outputs/sqlite-data .venv/bin/python -m desktop",
    "migrate:sqlite": ".venv/bin/python scripts/migrate_to_sqlite.py",
    "test:header": "node --experimental-strip-types --test scripts/test_header_motion.mjs"
  },
  "dependencies": {
    "konva": "10.3.2",
    "lucide-react": "1.40.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-konva": "19.2.5"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "concurrently": "10.0.5",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.4",
    "typescript": "5.9.3"
  }
}
